# Upload this file unchanged with the other files to the GitHub repository root.
# Railway > Variables uses it to suggest variables for you to add.
# Enter real tokens and IDs only in Railway, never in GitHub.
# LEVEL_x_HOURS is the TOTAL required voice time in hours.
DISCORD_TOKEN=YOUR_BOT_TOKEN
GUILD_ID=YOUR_SERVER_ID
LEVEL_COUNT=8

LEVEL_1_ROLE_ID=YOUR_LEVEL_1_ROLE_ID
LEVEL_1_HOURS=1
LEVEL_2_ROLE_ID=YOUR_LEVEL_2_ROLE_ID
LEVEL_2_HOURS=5
LEVEL_3_ROLE_ID=YOUR_LEVEL_3_ROLE_ID
LEVEL_3_HOURS=15
LEVEL_4_ROLE_ID=YOUR_LEVEL_4_ROLE_ID
LEVEL_4_HOURS=40
LEVEL_5_ROLE_ID=YOUR_LEVEL_5_ROLE_ID
LEVEL_5_HOURS=100

# Level 6 = OG Level 1, Level 7 = OG Level 2, Level 8 = OG Level 3.
# These total-hour thresholds are examples; choose the values you want in Railway.
# Each threshold must be greater than the previous one. No OG hours are assumed if omitted.
LEVEL_6_ROLE_ID=YOUR_OG_LEVEL_1_ROLE_ID
LEVEL_6_HOURS=200
LEVEL_7_ROLE_ID=YOUR_OG_LEVEL_2_ROLE_ID
LEVEL_7_HOURS=350
LEVEL_8_ROLE_ID=YOUR_OG_LEVEL_3_ROLE_ID
LEVEL_8_HOURS=500

# Optional: Role for people when they join the server. Empty = disabled.
# Use a separate role, not a LEVEL_x_ROLE_ID. Existing members are not affected.
# The bot needs Manage Roles, and its highest role must be above this role.
AUTO_ROLE_ID=

# highest = only the highest role; cumulative = all earned roles.
ROLE_MODE=highest
# 1 = count time even when alone in a call; 2 = at least two people required.
MIN_HUMANS_IN_CHANNEL=1
EXCLUDE_AFK_CHANNEL=true
EXCLUDE_DEAFENED=false
# Separate multiple channel IDs with commas. Empty = no additional exclusions.
IGNORED_CHANNEL_IDS=
SAVE_INTERVAL_SECONDS=30
# Optional: Text channel for level-up messages. Empty = no announcements.
LEVEL_UP_CHANNEL_ID=
# Create a volume mounted at /data for the bot service. Use ./data for local runs if needed.
DATA_DIR=/data

# Welcomer: ID of a standard text channel. false disables welcome messages.
WELCOME_ENABLED=true
WELCOME_CHANNEL_ID=YOUR_WELCOME_CHANNEL_ID
# As in the example, newly joined bots also receive a welcome message.
WELCOME_INCLUDE_BOTS=true
WELCOME_PING_USER=true
# Embed accent: automatically taken from the avatar; this color is the fallback.
# The welcome background always uses assets/welcome-background.png.
WELCOME_FALLBACK_COLOR="#8B5CF6"
# Available placeholders: {user}, {username}, {display_name}, {server},
# {member_count}, {member_count_ordinal}. \\n inserts a line break.
WELCOME_MESSAGE="Welcome {user} to **{server}**! You are the {member_count_ordinal} member!"
WELCOME_CARD_TEXT="Welcome {display_name}\\nto {server} you are the {member_count_ordinal} member!\\nHave fun playing, talking and more!"
