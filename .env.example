# Diese Datei unverändert mit den anderen Dateien in den GitHub-Hauptordner hochladen.
# Railway > Variables schlägt daraus alle Variablen automatisch zum Übernehmen vor.
# Echte Tokens/IDs nur in Railway eintragen, niemals in GitHub.
# LEVEL_x_HOURS ist die GESAMTE benötigte Call-Zeit in Stunden.
DISCORD_TOKEN=DEIN_BOT_TOKEN
GUILD_ID=DEINE_SERVER_ID
LEVEL_COUNT=5

LEVEL_1_ROLE_ID=DEINE_LEVEL_1_ROLLEN_ID
LEVEL_1_HOURS=1
LEVEL_2_ROLE_ID=DEINE_LEVEL_2_ROLLEN_ID
LEVEL_2_HOURS=5
LEVEL_3_ROLE_ID=DEINE_LEVEL_3_ROLLEN_ID
LEVEL_3_HOURS=15
LEVEL_4_ROLE_ID=DEINE_LEVEL_4_ROLLEN_ID
LEVEL_4_HOURS=40
LEVEL_5_ROLE_ID=DEINE_LEVEL_5_ROLLEN_ID
LEVEL_5_HOURS=100

# Optional: Rolle für Menschen direkt beim Serverbeitritt. Leer = ausgeschaltet.
# Eigene Rolle verwenden, keine der LEVEL_x_ROLE_IDs. Bestehende Mitglieder bleiben unverändert.
# Der Bot braucht Rollen verwalten und seine höchste Rolle muss über dieser Rolle stehen.
AUTO_ROLE_ID=

# highest = nur höchste Rolle; cumulative = alle erreichten Rollen.
ROLE_MODE=highest
# 1 = auch alleine im Call zählen; 2 = mindestens zwei Menschen nötig.
MIN_HUMANS_IN_CHANNEL=1
EXCLUDE_AFK_CHANNEL=true
EXCLUDE_DEAFENED=false
# Mehrere Channel-IDs durch Kommas trennen. Leer = keine zusätzlichen Ausschlüsse.
IGNORED_CHANNEL_IDS=
SAVE_INTERVAL_SECONDS=30
# Optional: Text-Channel für Level-Up-Nachrichten. Leer = keine Nachrichten.
LEVEL_UP_CHANNEL_ID=
# Ein Volume am Bot-Service unter /data anlegen. Lokal bei Bedarf ./data verwenden.
DATA_DIR=/data

# Welcomer: ID eines normalen Text-Channels. false schaltet den Welcomer aus.
WELCOME_ENABLED=true
WELCOME_CHANNEL_ID=DEINE_WELCOME_CHANNEL_ID
# Wie im Beispiel werden auch neu beigetretene Bots begrüsst.
WELCOME_INCLUDE_BOTS=true
WELCOME_PING_USER=true
# Embed-Akzent: automatisch aus dem Profilbild; diese Farbe dient als Ersatz.
# Der Welcome-Hintergrund ist immer das Bild in assets/welcome-background.png.
WELCOME_FALLBACK_COLOR="#8B5CF6"
# Verfügbare Platzhalter: {user}, {username}, {display_name}, {server},
# {member_count}, {member_count_ordinal}. \\n erzeugt einen Zeilenumbruch.
WELCOME_MESSAGE="Welcome {user} to **{server}**! You are the {member_count_ordinal} member!"
WELCOME_CARD_TEXT="Welcome {display_name}\\nto {server} you are the {member_count_ordinal} member!\\nHave fun playing, talking and more!"
